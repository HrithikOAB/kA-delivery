# ---- Digi Mess backend environment (copy to .env) ----
# NEVER commit a real .env. NEVER expose these secrets in the mobile app.

# PostgreSQL (preferred: component vars; no spaces around =)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=khana_delivery
DATABASE_USER=khana_app_user
DATABASE_PASSWORD=change-me

# Or a single URL instead of the vars above:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/khana_delivery

# Fresh server bootstrap (runs on API startup)
AUTO_MIGRATE_ON_STARTUP=true
# Demo riders/ops accounts (local dev only; skipped in production)
AUTO_SEED_ON_STARTUP=false
# Create super admin when the users table is empty
AUTO_SEED_ADMIN_ON_STARTUP=true
SEED_ADMIN_EMAIL=admin@kadelivery.app
SEED_ADMIN_PASSWORD=change-me-admin-password

# Auth / JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Informational base URLs (used by docs / clients)
API_BASE_URL=http://localhost:8000
WS_BASE_URL=ws://localhost:8000

# Map provider + server-side Google key (Routes API proxy for rider directions).
MAP_PROVIDER=none
GOOGLE_MAPS_API_KEY=

# Partner verification document uploads (local disk in dev).
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Rider location update policy
LOCATION_UPDATE_INTERVAL_SECONDS=5
LOCATION_DISTANCE_THRESHOLD_METERS=30
LOCATION_STALE_SECONDS=30
LOCATION_MAX_JUMP_METERS=2000
LOCATION_MAX_SPEED_MPS=55

# Tracking retention
TRACKING_RETENTION_HOURS=24
MAX_LOCATION_HISTORY=500

# OTP for delivery proof
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=30
DEFAULT_OTP=1212

# Customer phone login OTP (sent by SMS in prod; returned in dev responses)
LOGIN_OTP_LENGTH=4
LOGIN_OTP_EXPIRY_MINUTES=5

# Dispatch / batching rules
DISPATCH_OFFER_TIMEOUT_SECONDS=86400
DISPATCH_MAX_BATCH_SIZE=4
DISPATCH_MAX_MESS_RADIUS_KM=8

# WebSocket reconnect hints (surfaced to clients via /config)
WS_RECONNECT_BASE_MS=1000
WS_RECONNECT_MAX_MS=15000

# Stubbed integrations (no real credentials required in dev)
NOTIFICATION_PROVIDER=dev
EXPO_ACCESS_TOKEN=
PAYMENT_PROVIDER=cod

# Partner API (/api/v1/partner/*): keys are normally issued in the admin console
# (Settings -> Partner API keys). This optional static key is also accepted as X-API-Key.
INTEGRATION_API_KEY=
# External order API: source of order content (mess, customer, items, totals).
EXTERNAL_ORDER_API_URL=https://xy4kr747jd.execute-api.ap-south-1.amazonaws.com/Prod/getRiderOrder
EXTERNAL_ORDER_API_TIMEOUT_SECONDS=8
EXTERNAL_ORDER_API_KEY=
EXTERNAL_ORDER_API_KEY_HEADER=x-api-key

# CORS (comma-separated origins; * for dev).
CORS_ORIGINS=*
